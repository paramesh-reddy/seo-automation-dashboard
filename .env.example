# ==============================================================================
# EDGELINK TECHNOLOGY - SEO AUTOMATION DASHBOARD CONFIGURATION
# ==============================================================================

# Server & Application Configuration
PORT=3000
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/edgelink_seo?schema=public"

# Redis Configuration (BullMQ Background Worker)
# Supports Redis TCP connection string
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""

# Mock Control Switch (Section 7)
# When USE_MOCKS=true, PageSpeed, GSC, DataForSEO, and Twilio WhatsApp mocks are used.
# When USE_MOCKS=false, production credentials below are required.
USE_MOCKS=true

# Anthropic Claude AI (Section 8)
# System prompt and user prompt target claude-sonnet-4-6
ANTHROPIC_API_KEY="your-anthropic-api-key"
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Twilio WhatsApp Integration (Section 7.4)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="+14155238886"

# Real Integration Credentials (when USE_MOCKS=false)
PAGESPEED_API_KEY=""
GOOGLE_SEARCH_CONSOLE_TOKEN=""
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""

# Security & Cron Automation Secrets
AUTH_SECRET="super-secret-jwt-key-edgelink-2026"
CRON_SECRET="edgelink-cron-automation-token"

# Optional Gemini API Key (injected by AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
